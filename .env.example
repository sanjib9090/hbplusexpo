# Public client configuration. Do not put secrets or service-role keys here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android uses the package and signing SHA-1; this ID is for reference only.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Required before iOS prebuild.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
